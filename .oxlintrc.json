{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist",
    "rybinsk-events",
    "node_modules"
  ],
  "env": {
    "browser": true,
    "node": true
  }
}
